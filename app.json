{
  "expo": {
    "name": "ScamShield AI",
    "slug": "scamshield-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scamshield",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-splash-screen",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermissionString": "ScamShield AI uses the camera to scan QR codes and capture screenshots for scam analysis."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ScamShield AI accesses photos to analyze screenshots for potential scams.",
          "cameraPermission": "ScamShield AI uses the camera to capture evidence for scam analysis."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
